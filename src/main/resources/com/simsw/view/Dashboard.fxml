<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700" prefWidth="1150" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.simsw.controller.DashboardController">

   <!-- ================= HEADER RED (Disinkronkan ke #C62828) ================= -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="75.0" spacing="15" 
            style="-fx-background-color: #C62828; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);" 
            BorderPane.alignment="CENTER">
         <padding>
            <Insets left="30.0" right="30.0" />
         </padding>
         <children>
            <Label text="WarMis" textFill="WHITE">
               <font>
                  <Font size="26.0" />
               </font>
               <style>-fx-font-weight: 900;</style>
            </Label>
            <Label text="|" textFill="#FDA4AF">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <Label text="Warmindo Management System" textFill="#FFE4E6">
               <font>
                  <Font size="15.0" />
               </font>
               <style>-fx-font-weight: 500;</style>
            </Label>
            <HBox HBox.hgrow="ALWAYS" />
            <Label fx:id="lblUserInfo" text="👤 User | Role" textFill="WHITE" style="-fx-font-size: 14; -fx-font-weight: bold;" />
         </children>
      </HBox>
   </top>

   <!-- ================= SIDEBAR NAVIGASI ================= -->
   <left>
      <fx:include source="Sidebar.fxml" />
   </left>

   <!-- ================= MAIN CONTENT ================= -->
   <center>
      <VBox alignment="TOP_LEFT" spacing="25">
         <padding>
            <Insets bottom="30" left="35" right="35" top="30" />
         </padding>
         <children>
            
            <!-- WELCOME BANNER -->
            <VBox spacing="4">
               <children>
                  <Label fx:id="lblWelcome" text="Selamat Datang Kembali 👋" textFill="#0F172A" style="-fx-font-weight: 800;">
                     <font>
                        <Font size="28" />
                     </font>
                  </Label>
                  <Label fx:id="lblTanggal" text="Senin, 13 Juli 2026" textFill="#64748B" style="-fx-font-weight: 500;">
                     <font>
                        <Font size="14" />
                     </font>
                  </Label>
               </children>
            </VBox>

            <!-- ================= DASHBOARD CARDS ================= -->
            <GridPane hgap="20" maxWidth="Infinity" vgap="20">
               <columnConstraints>
                  <ColumnConstraints percentWidth="33.33" />
                  <ColumnConstraints percentWidth="33.33" />
                  <ColumnConstraints percentWidth="33.33" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints prefHeight="100" />
                  <RowConstraints prefHeight="100" />
               </rowConstraints>
               <children>
                  
                  <!-- CARD 1: Total Barang -->
                  <HBox alignment="CENTER_LEFT" maxWidth="Infinity" onMouseClicked="#openInventaris" spacing="18" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4); -fx-border-color: #E2E8F0; -fx-border-radius: 16; -fx-cursor: hand;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                     <children>
                        <VBox alignment="CENTER" minHeight="55" minWidth="55" style="-fx-background-color: #EFF6FF; -fx-background-radius: 12;">
                           <children>
                              <Label style="-fx-font-size: 24;" text="📦" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" spacing="2">
                           <children>
                              <Label style="-fx-font-size: 13; -fx-font-weight: 600;" text="Total Barang" textFill="#64748B" />
                              <Label fx:id="lblBarang" style="-fx-font-size: 26; -fx-font-weight: 800;" text="124" textFill="#1E293B" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- CARD 2: Total Menu -->
                  <HBox alignment="CENTER_LEFT" maxWidth="Infinity" onMouseClicked="#openMenu" spacing="18" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4); -fx-border-color: #E2E8F0; -fx-border-radius: 16; -fx-cursor: hand;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <children>
                        <VBox alignment="CENTER" minHeight="55" minWidth="55" style="-fx-background-color: #F1F5F9; -fx-background-radius: 12;">
                           <children>
                              <Label style="-fx-font-size: 24;" text="🍜" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" spacing="2">
                           <children>
                              <Label style="-fx-font-size: 13; -fx-font-weight: 600;" text="Total Menu" textFill="#64748B" />
                              <Label fx:id="lblMenu" style="-fx-font-size: 26; -fx-font-weight: 800;" text="42" textFill="#1E293B" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- CARD 3: Total Pegawai -->
                  <HBox alignment="CENTER_LEFT" maxWidth="Infinity" onMouseClicked="#openPegawai" spacing="18" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4); -fx-border-color: #E2E8F0; -fx-border-radius: 16; -fx-cursor: hand;" GridPane.columnIndex="2" GridPane.rowIndex="0">
                     <children>
                        <VBox alignment="CENTER" minHeight="55" minWidth="55" style="-fx-background-color: #EEF2F6; -fx-background-radius: 12;">
                           <children>
                              <Label style="-fx-font-size: 24;" text="👥" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" spacing="2">
                           <children>
                              <Label style="-fx-font-size: 13; -fx-font-weight: 600;" text="Total Pegawai" textFill="#64748B" />
                              <Label fx:id="lblPegawai" style="-fx-font-size: 26; -fx-font-weight: 800;" text="8" textFill="#1E293B" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- CARD 4: Stok Menipis -->
                  <HBox alignment="CENTER_LEFT" maxWidth="Infinity" onMouseClicked="#openStokMenipis" spacing="18" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4); -fx-border-color: #E2E8F0; -fx-border-radius: 16; -fx-cursor: hand;" GridPane.columnIndex="0" GridPane.rowIndex="1">
                     <children>
                        <VBox alignment="CENTER" minHeight="55" minWidth="55" style="-fx-background-color: #FEF2F2; -fx-background-radius: 12;">
                           <children>
                              <Label style="-fx-font-size: 24;" text="⚠" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" spacing="2">
                           <children>
                              <Label style="-fx-font-size: 13; -fx-font-weight: 600;" text="Stok Menipis" textFill="#64748B" />
                              <Label fx:id="lblStok" style="-fx-font-size: 26; -fx-font-weight: 800;" text="3" textFill="#EF4444" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- CARD 5: Total Kategori -->
                  <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="18" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4); -fx-border-color: #E2E8F0; -fx-border-radius: 16;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <VBox alignment="CENTER" minHeight="55" minWidth="55" style="-fx-background-color: #F5F3FF; -fx-background-radius: 12;">
                           <children>
                              <Label style="-fx-font-size: 24;" text="📂" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" spacing="2">
                           <children>
                              <Label style="-fx-font-size: 13; -fx-font-weight: 600;" text="Total Kategori" textFill="#64748B" />
                              <Label fx:id="lblKategori" style="-fx-font-size: 26; -fx-font-weight: 800;" text="6" textFill="#1E293B" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- CARD 6: Aktivitas Hari Ini -->
                  <HBox alignment="CENTER_LEFT" maxWidth="Infinity" onMouseClicked="#openAktivitasHariIni" spacing="18" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4); -fx-border-color: #E2E8F0; -fx-border-radius: 16; -fx-cursor: hand;" GridPane.columnIndex="2" GridPane.rowIndex="1">
                     <children>
                        <VBox alignment="CENTER" minHeight="55" minWidth="55" style="-fx-background-color: #F0FDF4; -fx-background-radius: 12;">
                           <children>
                              <Label style="-fx-font-size: 24;" text="📜" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" spacing="2">
                           <children>
                              <Label style="-fx-font-size: 13; -fx-font-weight: 600;" text="Aktivitas Hari Ini" textFill="#64748B" />
                              <Label fx:id="lblAktivitas" style="-fx-font-size: 26; -fx-font-weight: 800;" text="18" textFill="#1E293B" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

               </children>
            </GridPane>
            
            <Separator maxWidth="Infinity" style="-fx-opacity: 0.6;" />
            
         </children>
      </VBox>
   </center>
</BorderPane>
