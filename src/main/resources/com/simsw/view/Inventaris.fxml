<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.simsw.controller.InventarisController">
<top>
    <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="15" style="-fx-background-color: #D32F2F;" BorderPane.alignment="CENTER">

        <padding>
            <Insets left="20.0" right="20.0" />
        </padding>

        <children>

            <Button fx:id="btnDashboard" onAction="#backDashboard" style="-fx-background-color: white;                            -fx-text-fill: #D32F2F;                            -fx-font-weight: bold;" text="🏠 Dashboard" />

            <Label text="SIMS-W : WARMINDO STOCK MANAGER" textFill="WHITE">

                <font>
                    <Font size="24" />
                </font>

            </Label>

        </children>

    </HBox>
</top>
   <left>
      <VBox spacing="15.0" style="-fx-background-color: #F5F5F5;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Detail Item">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <VBox spacing="5.0">
               <children>
                  <Label text="Nama Item (e.g., Indomie Goreng)" />
                  <TextField fx:id="nameField" promptText="Masukkan nama item" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Kategori" />
                  <ComboBox fx:id="categoryCombo" prefHeight="25.0" prefWidth="256.0" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Stok saat ini" />
                  <TextField fx:id="stockField" promptText="0" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Titik Peringatan Stok Minimum" />
                  <TextField fx:id="alertField" promptText="0" />
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0">
               <children>
                  <Button fx:id="addButton" mnemonicParsing="false" onAction="#saveItem" prefHeight="35.0" prefWidth="250.0" style="-fx-background-color: #388E3C;" text="Add / Update Item" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="useStockButton" mnemonicParsing="false" prefHeight="35.0" prefWidth="250.0" style="-fx-background-color: #F57C00;" text="Use Item (-1 Stock)" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deleteItem" prefHeight="35.0" prefWidth="250.0" style="-fx-background-color: #D32F2F;" text="Delete Item" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
               </children>
               <padding>
                  <Insets top="10.0" />
               </padding>
            </VBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <VBox prefHeight="200.0" prefWidth="491.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Search Stock:" />
                  <TextField fx:id="searchField" prefHeight="25.0" prefWidth="300.0" promptText="Cari nama atau kategori..." />
               </children>
            </HBox>
            <TableView fx:id="inventoryTable" prefHeight="457.0" prefWidth="599.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="idColumn" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="200.0" text="Nama Item" />
                  <TableColumn fx:id="categoryColumn" prefWidth="120.0" text="Kategori" />
                  <TableColumn fx:id="stockColumn" prefWidth="100.0" text="Jumlah Stok" />
                  <TableColumn fx:id="statusColumn" prefWidth="132.0" text="Status" />
              </columns>
            </TableView>
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
