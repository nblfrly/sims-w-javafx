<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="700.0" prefWidth="1150.0" style="-fx-background-color: #FFFDFD;" 
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.simsw.controller.KelolaResepController">
   
   <!-- ================= HEADER WARMINDO RED ================= -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="75.0" spacing="15" 
            style="-fx-background-color: #BE123C; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);" 
            BorderPane.alignment="CENTER">
         <padding>
            <Insets left="30.0" right="30.0" />
         </padding>
         <children>
            <Label text="WarMis" textFill="WHITE">
               <font>
                  <Font size="26.0" />
               </font>
               <style>-fx-font-weight: 900;</style>
            </Label>
            <Label text="|" textFill="#FDA4AF">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <Label text="Kelola Resep Masakan" textFill="#FFE4E6">
               <font>
                  <Font size="15.0" />
               </font>
               <style>-fx-font-weight: 500;</style>
            </Label>
         </children>
      </HBox>
   </top>

   <!-- ================= SIDEBAR & FORM INPUT ================= -->
   <left>
      <HBox BorderPane.alignment="CENTER">
         <children>
            <!-- Sidebar Include -->
            <fx:include source="Sidebar.fxml" />
            
            <!-- Side Form Panel -->
            <VBox prefWidth="300.0" spacing="16.0" 
                  style="-fx-background-color: white; -fx-border-color: transparent #E2E8F0 transparent transparent; -fx-border-width: 0 1 0 0;">
               <padding>
                  <Insets bottom="25.0" left="22.0" right="22.0" top="25.0" />
               </padding>
               <children>
                  <Label text="Detail Resep" textFill="#0F172A">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <style>-fx-font-weight: 800;</style>
                  </Label>
                  
                  <!-- Input: Menu -->
                  <VBox spacing="6.0">
                     <children>
                        <Label text="Menu Hidangan" textFill="#64748B">
                           <style>-fx-font-weight: 600; -fx-font-size: 12;</style>
                        </Label>
                        <ComboBox fx:id="cmbMenu" maxWidth="Infinity" prefHeight="38.0" promptText="- Pilih Menu -" 
                                  style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 4 0 4;" />
                     </children>
                  </VBox>
                  
                  <!-- Input: Barang -->
                  <VBox spacing="6.0">
                     <children>
                        <Label text="Bahan Baku / Barang" textFill="#64748B">
                           <style>-fx-font-weight: 600; -fx-font-size: 12;</style>
                        </Label>
                        <ComboBox fx:id="cmbBarang" maxWidth="Infinity" prefHeight="38.0" promptText="- Pilih Barang -" 
                                  style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 4 0 4;" />
                     </children>
                  </VBox>
                  
                  <!-- Input: Jumlah Dipakai -->
                  <VBox spacing="6.0">
                     <children>
                        <Label text="Jumlah Dipakai" textFill="#64748B">
                           <style>-fx-font-weight: 600; -fx-font-size: 12;</style>
                        </Label>
                        <TextField fx:id="txtJumlah" prefHeight="38.0" promptText="Contoh: 1" 
                                   style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12 0 12; -fx-text-fill: #1E293B;" />
                     </children>
                  </VBox>
                  
                  <Separator style="-fx-opacity: 0.6;" />
                  
                  <!-- Action Buttons Container -->
                  <VBox spacing="10.0">
                     <children>
                        <!-- Button: Tambah -->
                        <Button fx:id="btnTambah" maxWidth="Infinity" mnemonicParsing="false" onAction="#saveResep" prefHeight="40.0" 
                                style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 13.0; -fx-font-weight: bold; -fx-cursor: hand;" 
                                text="➕   Tambah Resep" />
                        
                        <!-- Button: Hapus -->
                        <Button fx:id="btnDelete" maxWidth="Infinity" mnemonicParsing="false" onAction="#deleteResep" prefHeight="40.0" 
                                style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 13.0; -fx-font-weight: bold; -fx-cursor: hand;" 
                                text="🗑   Hapus Bahan" />
                        
                        <!-- Button: Reset Form -->
                        <Button fx:id="btnReset" maxWidth="Infinity" mnemonicParsing="false" onAction="#resetForm" prefHeight="35.0" 
                                style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12.0; -fx-font-weight: 600; -fx-cursor: hand;" 
                                text="🔄   Reset Form" />
                     </children>
                     <padding>
                        <Insets top="4.0" />
                     </padding>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </left>

   <!-- ================= MAIN TABLE VIEW DATA ================= -->
   <center>
      <VBox spacing="18.0" BorderPane.alignment="CENTER">
         <children>
            
            <!-- Search Bar Layout -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" 
                  style="-fx-background-color: white; -fx-padding: 14 20 14 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 8, 0, 0, 2); -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
               <children>
                  <Label text="🔍" style="-fx-font-size: 16;" />
                  <Label text="Search Resep:" textFill="#334155">
                     <style>-fx-font-weight: 700; -fx-font-size: 14;</style>
                  </Label>
                  <TextField fx:id="txtSearch" HBox.hgrow="ALWAYS" prefHeight="38.0" promptText="Cari nama menu hidangan atau bahan baku resep..." 
                             style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12 0 12; -fx-text-fill: #1E293B;" />
               </children>
            </HBox>
            
            <!-- Modern Table Layout -->
            <TableView fx:id="tableResep" VBox.vgrow="ALWAYS" 
                       style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-padding: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 8, 0, 0, 4);">
               <columns>
                  <TableColumn fx:id="colId" minWidth="60.0" prefWidth="70.0" text="ID" style="-fx-alignment: CENTER;" />
                  <TableColumn fx:id="colMenu" minWidth="220.0" prefWidth="260.0" text="Menu" />
                  <TableColumn fx:id="colBarang" minWidth="220.0" prefWidth="260.0" text="Barang / Bahan Baku" />
                  <TableColumn fx:id="colJumlah" minWidth="100.0" prefWidth="120.0" text="Jumlah Kuantitas" style="-fx-alignment: CENTER;" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>