<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700" prefWidth="1000" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.simsw.controller.KelolaResepController">
    
    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70" spacing="15" style="-fx-background-color: #C62828;">
            <padding>
                <Insets left="20" right="20" />
            </padding>
            <children>
                <Button fx:id="btnMenu" onAction="#backMenu" style="-fx-background-color: white; -fx-text-fill: #C62828; -fx-font-weight: bold;" text="🍜 Menu" />
                <Label text="WarMis | Kelola Resep" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="24" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>

    <!-- SIDEBAR FORM (LEFT) -->
    <left>
        <VBox prefWidth="300" spacing="15" style="-fx-background-color: #F5F5F5;">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <children>
                <Label style="-fx-font-weight: bold;" text="Detail Resep">
                    <font>
                        <Font size="18" />
                    </font>
                </Label>
                
                <VBox spacing="5">
                    <Label text="Menu" />
                    <ComboBox fx:id="cmbMenu" prefWidth="260" promptText="- Pilih Menu -" />
                </VBox>
                
                <VBox spacing="5">
                    <Label text="Barang" />
                    <ComboBox fx:id="cmbBarang" prefWidth="260" promptText="- Pilih Barang -" />
                </VBox>
                
                <VBox spacing="5">
                    <Label text="Jumlah Dipakai" />
                    <TextField fx:id="txtJumlah" prefWidth="260" promptText="1" />
                </VBox>
                
                <Separator />
                
                <!-- Tombol disamakan lebarnya (prefWidth="260") supaya sejajar rapi dengan inputan diatasnya -->
                <Button fx:id="btnTambah" onAction="#saveResep" prefHeight="38" prefWidth="260" style="-fx-background-color: #388E3C; -fx-text-fill: white; -fx-font-weight: bold;" text="Tambah" />
                <Button fx:id="btnDelete" onAction="#deleteResep" prefHeight="38" prefWidth="260" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-font-weight: bold;" text="Hapus" />
                <Button fx:id="btnReset" onAction="#resetForm" prefHeight="38" prefWidth="260" text="Reset" />
            </children>
        </VBox>
    </left>

    <!-- MAIN CONTENT (CENTER) -->
    <center>
        <VBox spacing="15">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-weight: bold;" text="Search:" />
                    <TextField fx:id="txtSearch" prefWidth="320" promptText="Cari Menu atau Barang..." />
                </HBox>
                
                <TableView fx:id="tableResep" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                        <TableColumn fx:id="colMenu" prefWidth="260" text="Menu" />
                        <TableColumn fx:id="colBarang" prefWidth="260" text="Barang" />
                        <TableColumn fx:id="colJumlah" prefWidth="120" text="Jumlah" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
    
</BorderPane>