<?xml version="1.0" encoding="UTF-8"?>

<!-- Tampilan Pegawai Manager Modis & Profesional -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<!-- Fixed typo syntax alignment -->
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1150.0" style="-fx-background-color: #FFFDFD;" 
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.simsw.controller.PegawaiController">
   
   <!-- ================= HEADER WARMINDO RED ================= -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="75.0" spacing="15" 
            style="-fx-background-color: #BE123C; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);" 
            BorderPane.alignment="CENTER">
         <padding>
            <Insets left="30.0" right="30.0" />
         </padding>
         <children>
            <Label text="WarMis" textFill="WHITE">
               <font>
                  <Font size="26.0" />
               </font>
               <style>-fx-font-weight: 900;</style>
            </Label>
            <Label text="|" textFill="#FDA4AF">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <Label text="Employee Management System" textFill="#FFE4E6">
               <font>
                  <Font size="15.0" />
               </font>
               <style>-fx-font-weight: 500;</style>
            </Label>
         </children>
      </HBox>
   </top>
   
   <!-- ================= SIDEBAR MENU ================= -->
   <left>
      <fx:include source="Sidebar.fxml" />
   </left>
   
   <!-- ================= MAIN CONTENT AREA ================= -->
   <center>
      <VBox spacing="18.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
         </padding>
         <children>
            
            <!-- ================= MODERN DATA FORM CONTAINER ================= -->
            <HBox spacing="25.0" 
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 8, 0, 0, 4);">
               <children>
                  
                  <!-- Form Fields Side -->
                  <GridPane hgap="20.0" vgap="14.0" HBox.hgrow="ALWAYS">
                     <columnConstraints>
                        <ColumnConstraints prefWidth="100.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                        <ColumnConstraints prefWidth="100.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="38.0" prefHeight="38.0" />
                        <RowConstraints minHeight="38.0" prefHeight="38.0" />
                     </rowConstraints>
                     <children>
                        <!-- Nama Pegawai -->
                        <Label text="Nama Lengkap" textFill="#475569" GridPane.columnIndex="0" GridPane.rowIndex="0">
                           <style>-fx-font-weight: 700; -fx-font-size: 13;</style>
                        </Label>
                        <TextField fx:id="nameField" prefHeight="38.0" promptText="Masukkan nama pegawai" 
                                   style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12 0 12; -fx-text-fill: #1E293B;" 
                                   GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        
                        <!-- Username -->
                        <Label text="Username" textFill="#475569" GridPane.columnIndex="2" GridPane.rowIndex="0">
                           <style>-fx-font-weight: 700; -fx-font-size: 13;</style>
                        </Label>
                        <TextField fx:id="usernameField" prefHeight="38.0" promptText="Masukkan username" 
                                   style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12 0 12; -fx-text-fill: #1E293B;" 
                                   GridPane.columnIndex="3" GridPane.rowIndex="0" />
                        
                        <!-- Password -->
                        <Label text="Password" textFill="#475569" GridPane.columnIndex="0" GridPane.rowIndex="1">
                           <style>-fx-font-weight: 700; -fx-font-size: 13;</style>
                        </Label>
                        <PasswordField fx:id="passwordField" prefHeight="38.0" promptText="••••••••" 
                                       style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12 0 12; -fx-text-fill: #1E293B;" 
                                       GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <!-- Role -->
                        <Label text="Hak Akses / Role" textFill="#475569" GridPane.columnIndex="2" GridPane.rowIndex="1">
                           <style>-fx-font-weight: 700; -fx-font-size: 13;</style>
                        </Label>
                        <ComboBox fx:id="roleCombo" maxWidth="Infinity" prefHeight="38.0" promptText="- Pilih Role -" 
                                  style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 0 4 0 4;" 
                                  GridPane.columnIndex="3" GridPane.rowIndex="1" />
                     </children>
                  </GridPane>
                  
                  <!-- Form Action Buttons Stack Side -->
                  <VBox alignment="CENTER" spacing="10.0" prefWidth="180.0">
                     <children>
                        <Button fx:id="saveButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#savePegawai" prefHeight="38.0" 
                                style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 13.0; -fx-font-weight: bold; -fx-cursor: hand;" 
                                text="➕  Simpan Pegawai" />
                        <Button fx:id="deleteButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#deletePegawai" prefHeight="38.0" 
                                style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 13.0; -fx-font-weight: bold; -fx-cursor: hand;" 
                                text="🗑  Hapus Akun" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            
            <!-- ================= MODERN INTERACTIVE SEARCH BAR ================= -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" 
                  style="-fx-background-color: white; -fx-padding: 14 20 14 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 8, 0, 0, 2); -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
               <children>
                  <Label text="🔍" style="-fx-font-size: 16;" />
                  <Label text="Cari Karyawan:" textFill="#334155">
                     <style>-fx-font-weight: 700; -fx-font-size: 14;</style>
                  </Label>
                  <TextField fx:id="searchField" HBox.hgrow="ALWAYS" prefHeight="38.0" promptText="Masukkan nama lengkap atau nama pengguna akun pegawai..." 
                             style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12 0 12; -fx-text-fill: #1E293B;" />
               </children>
            </HBox>
            
            <!-- ================= MODERN EMPLOYEES TABLE ================= -->
            <TableView fx:id="pegawaiTable" VBox.vgrow="ALWAYS" 
                       style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-padding: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 8, 0, 0, 4);">
               <columns>
                  <TableColumn fx:id="idColumn" minWidth="60.0" prefWidth="80.0" text="ID User" style="-fx-alignment: CENTER;" />
                  <TableColumn fx:id="nameColumn" minWidth="280.0" prefWidth="350.0" text="Nama Lengkap Pegawai" />
                  <TableColumn fx:id="usernameColumn" minWidth="200.0" prefWidth="260.0" text="Username Akun" />
                  <TableColumn fx:id="roleColumn" minWidth="150.0" prefWidth="180.0" text="Role Akses" style="-fx-alignment: CENTER;" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>