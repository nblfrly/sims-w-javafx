<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="700.0" prefWidth="1150.0" style="-fx-background-color: #FFFDFD;" 
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.simsw.controller.PenggunaanBarangController">
   
   <!-- ================= HEADER WARMINDO RED ================= -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="75.0" spacing="15" 
            style="-fx-background-color: #BE123C; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);" 
            BorderPane.alignment="CENTER">
         <padding>
            <Insets left="30.0" right="30.0" />
         </padding>
         <children>
            <Label text="WarMis" textFill="WHITE">
               <font>
                  <Font size="26.0" />
               </font>
               <style>-fx-font-weight: 900;</style>
            </Label>
            <Label text="|" textFill="#FDA4AF">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <Label text="Penggunaan Stok Barang" textFill="#FFE4E6">
               <font>
                  <Font size="15.0" />
               </font>
               <style>-fx-font-weight: 500;</style>
            </Label>
         </children>
      </HBox>
   </top>

   <!-- ================= SIDEBAR & TRANSAKSI PANEL ================= -->
   <left>
      <HBox BorderPane.alignment="CENTER">
         <children>
            <!-- Sidebar Include -->
            <fx:include source="Sidebar.fxml" />
            
            <!-- Side Transaction Panel -->
            <VBox prefWidth="320.0" spacing="16.0" 
                  style="-fx-background-color: white; -fx-border-color: transparent #E2E8F0 transparent transparent; -fx-border-width: 0 1 0 0;">
               <padding>
                  <Insets bottom="25.0" left="22.0" right="22.0" top="25.0" />
               </padding>
               <children>
                  <Label text="Transaksi Penggunaan" textFill="#0F172A">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <style>-fx-font-weight: 800;</style>
                  </Label>
                  
                  <!-- Input: Pilih Menu -->
                  <VBox spacing="6.0">
                     <children>
                        <Label text="Menu Warmindo" textFill="#64748B">
                           <style>-fx-font-weight: 600; -fx-font-size: 12;</style>
                        </Label>
                        <ComboBox fx:id="cmbMenu" maxWidth="Infinity" prefHeight="38.0" promptText="Pilih Menu Hidangan" 
                                  style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 4 0 4;" />
                     </children>
                  </VBox>
                  
                  <!-- Input: Jumlah Porsi -->
                  <VBox spacing="6.0">
                     <children>
                        <Label text="Jumlah Produksi (Porsi)" textFill="#64748B">
                           <style>-fx-font-weight: 600; -fx-font-size: 12;</style>
                        </Label>
                        <Spinner fx:id="spJumlah" maxWidth="Infinity" prefHeight="38.0" 
                                 style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-background-radius: 8; -fx-border-radius: 8;" />
                     </children>
                  </VBox>
                  
                  <Separator style="-fx-opacity: 0.6;" />
                  
                  <!-- Action Buttons Container -->
                  <VBox spacing="10.0">
                     <children>
                        <!-- Button: Preview -->
                        <Button fx:id="btnPreview" maxWidth="Infinity" mnemonicParsing="false" onAction="#previewPenggunaan" prefHeight="40.0" 
                                style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 13.0; -fx-font-weight: bold; -fx-cursor: hand;" 
                                text="📊   Preview Penggunaan" />
                        
                        <!-- Button: Gunakan -->
                        <Button fx:id="btnGunakan" maxWidth="Infinity" mnemonicParsing="false" onAction="#gunakanBarang" prefHeight="40.0" 
                                style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 13.0; -fx-font-weight: bold; -fx-cursor: hand;" 
                                text="✔   Gunakan Barang" />
                        
                        <!-- Button: Reset -->
                        <Button fx:id="btnReset" maxWidth="Infinity" mnemonicParsing="false" onAction="#resetForm" prefHeight="35.0" 
                                style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12.0; -fx-font-weight: 600; -fx-cursor: hand;" 
                                text="🔄   Reset Form" />
                     </children>
                     <padding>
                        <Insets top="4.0" />
                     </padding>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </left>

   <!-- ================= MAIN PREVIEW TABLE ================= -->
   <center>
      <VBox spacing="18.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Preview Barang yang Akan Digunakan" textFill="#0F172A">
               <font>
                  <Font size="18.0" />
               </font>
               <style>-fx-font-weight: 800;</style>
            </Label>
            
            <!-- Modern Table Layout -->
            <TableView fx:id="tablePreview" VBox.vgrow="ALWAYS" 
                       style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-padding: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 8, 0, 0, 4);">
               <columns>
                  <TableColumn fx:id="colBarang" minWidth="250.0" prefWidth="300.0" text="Nama Barang / Bahan Baku" />
                  <TableColumn fx:id="colStok" minWidth="120.0" prefWidth="150.0" text="Stok Saat Ini" style="-fx-alignment: CENTER;" />
                  <TableColumn fx:id="colPakai" minWidth="120.0" prefWidth="150.0" text="Akan Dipakai" style="-fx-alignment: CENTER;" />
                  <TableColumn fx:id="colSisa" minWidth="120.0" prefWidth="150.0" text="Sisa Stok perkiraan" style="-fx-alignment: CENTER;" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            
            <Separator style="-fx-opacity: 0.6;" />
            
            <!-- Modern Info Status Badge Bar -->
            <HBox alignment="CENTER_LEFT" spacing="10.0" 
                  style="-fx-background-color: #F1F5F9; -fx-padding: 12 20 12 20; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
               <children>
                  <Label text="💡  Status :" textFill="#475569">
                     <style>-fx-font-weight: bold; -fx-font-size: 13;</style>
                  </Label>
                  <Label fx:id="lblStatus" text="Belum ada transaksi aktif." textFill="#1E293B">
                     <font>
                        <Font size="13.0" />
                     </font>
                     <style>-fx-font-weight: 600;</style>
                  </Label>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>