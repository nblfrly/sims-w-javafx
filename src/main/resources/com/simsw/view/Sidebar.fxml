<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Perubahan Warna Latar Ke #FFF1F2 (Rose Cream) & Garis Pembatas Ke #FFE4E6 -->
<VBox minWidth="240" prefWidth="240" spacing="6" 
      style="-fx-background-color: #FFF1F2; -fx-border-color: transparent #FFE4E6 transparent transparent; -fx-border-width: 0 1 0 0;" 
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.simsw.controller.SidebarController">
   
   <padding>
      <Insets bottom="25" left="16" right="16" top="25" />
   </padding>
   
   <children>
      <!-- HEADER MENU -->
      <!-- Teks judul diubah menjadi merah gelap maroon agar kontras di atas warna putih-pink -->
      <Label text="MAIN MENU" textFill="#9F1239">
         <font>
            <Font size="11.0" />
         </font>
         <style>-fx-font-weight: bold; -fx-letter-spacing: 1px;</style>
      </Label>
      
      <Region prefHeight="10" />
   
      <!-- ================= NAVIGATION BUTTONS ================= -->
      
      <!-- Dashboard (Kondisi Aktif/Selected: Merah Bold khas Warmindo) -->
      <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#openDashboard" prefHeight="44" 
              style="-fx-alignment: CENTER_LEFT; -fx-padding: 0 16 0 16; -fx-background-color: #BE123C; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(190,18,60,0.2), 8, 0, 0, 3);" 
              text="🏠   Dashboard" />
      
      <!-- Inventaris (Kondisi Standby: Teks Abu-Gelap Kemerahan agar seimbang) -->
      <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#openInventaris" prefHeight="44" 
              style="-fx-alignment: CENTER_LEFT; -fx-padding: 0 16 0 16; -fx-background-color: transparent; -fx-text-fill: #4C0519; -fx-font-size: 14; -fx-background-radius: 10; -fx-cursor: hand;" 
              text="📦   Inventaris" />
      
      <!-- Menu Warmindo -->
      <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#openMenu" prefHeight="44" 
              style="-fx-alignment: CENTER_LEFT; -fx-padding: 0 16 0 16; -fx-background-color: transparent; -fx-text-fill: #4C0519; -fx-font-size: 14; -fx-background-radius: 10; -fx-cursor: hand;" 
              text="🍜   Menu Warmindo" />
      
      <!-- Penggunaan Barang -->
      <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#openPenggunaan" prefHeight="44" 
              style="-fx-alignment: CENTER_LEFT; -fx-padding: 0 16 0 16; -fx-background-color: transparent; -fx-text-fill: #4C0519; -fx-font-size: 14; -fx-background-radius: 10; -fx-cursor: hand;" 
              text="📋   Penggunaan Barang" />
      
      <!-- Riwayat -->
      <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#openRiwayat" prefHeight="44" 
              style="-fx-alignment: CENTER_LEFT; -fx-padding: 0 16 0 16; -fx-background-color: transparent; -fx-text-fill: #4C0519; -fx-font-size: 14; -fx-background-radius: 10; -fx-cursor: hand;" 
              text="🕘   Riwayat" />
      
      <!-- Pegawai -->
      <Button fx:id="btnPegawai" maxWidth="Infinity" mnemonicParsing="false" onAction="#openPegawai" prefHeight="44" 
              style="-fx-alignment: CENTER_LEFT; -fx-padding: 0 16 0 16; -fx-background-color: transparent; -fx-text-fill: #4C0519; -fx-font-size: 14; -fx-background-radius: 10; -fx-cursor: hand;" 
              text="👥   Pegawai" />
   
      <Region VBox.vgrow="ALWAYS" />
      
      <!-- ================= LOGOUT BUTTON ================= -->
      <!-- Dibuat kontras menggunakan warna solid Maroon gelap dengan teks putih agar estetik di bagian bawah -->
      <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#logout" prefHeight="44" 
              style="-fx-alignment: CENTER_LEFT; -fx-padding: 0 16 0 16; -fx-background-color: #BE123C; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 8, 0, 0, 2);" 
              text="↩   Keluar" />
      
   </children>
</VBox>