<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox minWidth="240" prefWidth="240" spacing="8" 
      style="-fx-background-color: #FAFAFA; -fx-border-color: transparent #E0E0E0 transparent transparent; -fx-border-width: 0 1 0 0;" 
      xmlns="http://javafx.com/javafx/26" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.simsw.controller.SidebarController">
   
   <padding>
      <Insets bottom="18" left="14" right="14" top="22" />
   </padding>
   
   <children>
      <!-- Label Navigasi -->
      <Label style="-fx-font-weight: bold;" text="NAVIGASI" textFill="#8D2020">
         <font>
            <Font size="11" />
         </font>
      </Label>
      
      <Region prefHeight="8" />
      
      <!-- Menu 1: Dashboard -->
      <Button fx:id="btnDashboard" maxWidth="Infinity" mnemonicParsing="false" onAction="#openDashboard" prefHeight="46" 
              style="-fx-alignment: CENTER_LEFT; -fx-padding: 0 14 0 14; -fx-background-color: transparent; -fx-text-fill: #333333; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 9; -fx-cursor: hand;" 
              text="🏠   Dashboard" />
              
      <!-- Menu 2: Inventaris -->
      <Button fx:id="btnInventaris" maxWidth="Infinity" mnemonicParsing="false" onAction="#openInventaris" prefHeight="46" 
              style="-fx-alignment: CENTER_LEFT; -fx-padding: 0 14 0 14; -fx-background-color: transparent; -fx-text-fill: #333333; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 9; -fx-cursor: hand;" 
              text="📦   Inventaris" />
              
      <!-- Menu 3: Menu Warmindo -->
      <Button fx:id="btnMenu" maxWidth="Infinity" mnemonicParsing="false" onAction="#openMenu" prefHeight="46" 
              style="-fx-alignment: CENTER_LEFT; -fx-padding: 0 14 0 14; -fx-background-color: transparent; -fx-text-fill: #333333; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 9; -fx-cursor: hand;" 
              text="🍜   Menu Warmindo" />
              
      <!-- Menu 4: Penggunaan Barang -->
      <Button fx:id="btnPenggunaan" maxWidth="Infinity" mnemonicParsing="false" onAction="#openPenggunaan" prefHeight="46" 
              style="-fx-alignment: CENTER_LEFT; -fx-padding: 0 14 0 14; -fx-background-color: transparent; -fx-text-fill: #333333; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 9; -fx-cursor: hand;" 
              text="📋   Penggunaan Barang" />
              
      <!-- Menu 5: Riwayat -->
      <Button fx:id="btnRiwayat" maxWidth="Infinity" mnemonicParsing="false" onAction="#openRiwayat" prefHeight="46" 
              style="-fx-alignment: CENTER_LEFT; -fx-padding: 0 14 0 14; -fx-background-color: transparent; -fx-text-fill: #333333; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 9; -fx-cursor: hand;" 
              text="🕘   Riwayat" />
              
      <!-- Menu 6: Pegawai -->
      <Button fx:id="btnPegawai" maxWidth="Infinity" mnemonicParsing="false" onAction="#openPegawai" prefHeight="46" 
              style="-fx-alignment: CENTER_LEFT; -fx-padding: 0 14 0 14; -fx-background-color: transparent; -fx-text-fill: #333333; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 9; -fx-cursor: hand;" 
              text="👥   Pegawai" />
              
      <!-- Spacer to Push Logout Down -->
      <Region VBox.vgrow="ALWAYS" />
      
      <!-- Tombol Keluar -->
      <Button fx:id="btnLogout" maxWidth="Infinity" mnemonicParsing="false" onAction="#logout" prefHeight="46" 
              style="-fx-alignment: CENTER_LEFT; -fx-padding: 0 14 0 14; -fx-background-color: #FEE2E2; -fx-text-fill: #991B1B; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 9; -fx-cursor: hand;" 
              text="↪   Keluar" />
   </children>
</VBox>