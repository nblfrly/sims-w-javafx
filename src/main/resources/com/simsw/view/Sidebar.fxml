<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="sidebar" maxWidth="240" minWidth="60" prefWidth="60" spacing="8" style="-fx-background-color:#FAFAFA;              -fx-border-color:transparent #E0E0E0 transparent transparent;              -fx-border-width:0 1 0 0;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.simsw.controller.SidebarController">

    <padding>
        <Insets bottom="18" left="14" right="14" top="22" />
    </padding>

    <children>

        <!-- Hidden while collapsed -->
        <Label fx:id="lblNav" managed="false" style="-fx-font-weight:bold;" text="NAVIGASI" textFill="#8D2020" visible="false">
            <font>
                <Font size="11" />
            </font>
        </Label>

        <Region prefHeight="8" />

        <Button fx:id="btnDashboard" maxWidth="Infinity" onAction="#openDashboard" prefHeight="46" style="-fx-alignment:CENTER;                        -fx-background-color:transparent;                        -fx-text-fill:#333333;                        -fx-font-size:18;                        -fx-font-weight:bold;                        -fx-background-radius:9;                        -fx-cursor:hand;" text="🏠" />

        <Button fx:id="btnInventaris" maxWidth="Infinity" onAction="#openInventaris" prefHeight="46" style="-fx-alignment:CENTER;                        -fx-background-color:transparent;                        -fx-text-fill:#333333;                        -fx-font-size:18;                        -fx-font-weight:bold;                        -fx-background-radius:9;                        -fx-cursor:hand;" text="📦" />

        <Button fx:id="btnMenu" maxWidth="Infinity" onAction="#openMenu" prefHeight="46" style="-fx-alignment:CENTER;                        -fx-background-color:transparent;                        -fx-text-fill:#333333;                        -fx-font-size:18;                        -fx-font-weight:bold;                        -fx-background-radius:9;                        -fx-cursor:hand;" text="🍜" />

        <Button fx:id="btnPenggunaan" maxWidth="Infinity" onAction="#openPenggunaan" prefHeight="46" style="-fx-alignment:CENTER;                        -fx-background-color:transparent;                        -fx-text-fill:#333333;                        -fx-font-size:18;                        -fx-font-weight:bold;                        -fx-background-radius:9;                        -fx-cursor:hand;" text="📋" />

        <Button fx:id="btnRiwayat" maxWidth="Infinity" onAction="#openRiwayat" prefHeight="46" style="-fx-alignment:CENTER;                        -fx-background-color:transparent;                        -fx-text-fill:#333333;                        -fx-font-size:18;                        -fx-font-weight:bold;                        -fx-background-radius:9;                        -fx-cursor:hand;" text="🕘" />

        <Button fx:id="btnPegawai" maxWidth="Infinity" onAction="#openPegawai" prefHeight="46" style="-fx-alignment:CENTER;                        -fx-background-color:transparent;                        -fx-text-fill:#333333;                        -fx-font-size:18;                        -fx-font-weight:bold;                        -fx-background-radius:9;                        -fx-cursor:hand;" text="👥" />

        <Region VBox.vgrow="ALWAYS" />

        <Button fx:id="btnLogout" maxWidth="Infinity" onAction="#logout" prefHeight="46" style="-fx-alignment:CENTER;                        -fx-background-color:#FEE2E2;                        -fx-text-fill:#991B1B;                        -fx-font-size:18;                        -fx-font-weight:bold;                        -fx-background-radius:9;                        -fx-cursor:hand;" text="↪" />

    </children>

</VBox>
